{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Linked-accounts API only. The app itself is a static site hosted anywhere.
  "name": "drivegallery-links",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  // Create with: npx wrangler kv namespace create DG_KV  (then paste the id here).
  // Local `wrangler dev` uses a simulated KV, so the placeholder is fine for development.
  "kv_namespaces": [{ "binding": "DG_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    // Where the app runs (comma-separated). Used for CORS and to report back from the popup.
    "APP_ORIGINS": "https://gallery.example.com"
  },
  "observability": { "enabled": true },
  "dev": { "port": 8787 }
  // Secrets (wrangler secret put …, or .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_KEY
}
