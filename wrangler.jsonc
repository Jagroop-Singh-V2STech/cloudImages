{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Linked-accounts API and phone pairing rooms only. The app itself is a static site hosted anywhere.
  "name": "misty-lake-3f3a",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-24",
  "kv_namespaces": [{ "binding": "DG_KV", "id": "a5e1f43d7de84f2f98804c3f26b6a505" }],
  // Pairing rooms for "Send from phone" (relays small messages; no storage used).
  "durable_objects": { "bindings": [{ "name": "BEAM", "class_name": "BeamRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BeamRoom"] }],
  "vars": {
    // Where the app runs (comma-separated). Used for CORS and to report back from the popup.
    "APP_ORIGINS": "https://cloud-images-seven.vercel.app/"
  },
  "observability": { "enabled": true },
  "dev": { "port": 8787 }
  // Secrets (wrangler secret put …, or .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_KEY
}
