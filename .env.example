# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com

# Optional: URL of the linked-accounts Worker (see README). Leave empty in development,
# where Vite proxies /api and /link to `npm run dev:worker`.
VITE_LINK_API_URL=
